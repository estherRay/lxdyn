set(CMAKE_SYSTEM_NAME @SYSTEM@)
set(CMAKE_SYSTEM_PROCESSOR @PROCESSOR@)
set(CMAKE_C_COMPILER @BIN@/zig-cc)
set(CMAKE_CXX_COMPILER @BIN@/zig-cxx)
set(CMAKE_RC_COMPILER @BIN@/zig-rc)

# The archiver too, not just the compiler. Without these CMake finds the host's ar and ranlib,
# which are built for one architecture: indexing aarch64 or COFF objects with a single-target
# binutils is Hazard R's shape, and the bad archive ends up in a published closure. zig ar is
# target-agnostic. These wrappers shipped for a long time without being wired to anything.
set(CMAKE_AR @BIN@/zig-ar)
set(CMAKE_RANLIB @BIN@/zig-ranlib)

# Only the closure's own install tree may satisfy find_package: any host hit is a libstdc++ build.
set(CMAKE_FIND_ROOT_PATH @PREFIX@)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

# PROGRAM is the exception: the host protoc and grpc_cpp_plugin are found on PATH on purpose.
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
