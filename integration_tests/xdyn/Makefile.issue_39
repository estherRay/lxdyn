issue_39: demos
	@echo "Running simulation for issue #39 (with time shift)..."
	@cd $(WORK) && $(XDYN) issue_39.yml -s euler --dt 1 --tend 11
	@cd $(WORK) && mv issue_39.out.csv issue_39.out.with_shift.csv
	@echo "Running simulation for issue #39 (without time shift)..."
	@cd $(WORK) && sed "s/shift time column to match tstart: true/shift time column to match tstart: false/g" issue_39.yml > issue_39_without_shift.yml
	@cd $(WORK) && $(XDYN) issue_39_without_shift.yml -s euler --dt 1 --tend 11
	@cd $(WORK) && mv issue_39.out.csv issue_39.out.without_shift.csv
	@echo "Checking commands generated from CSV (issue #39)"
	@cd $(WORK) && $(PYTHON) issue_39.py
	@echo "✓ Output is correct!"
