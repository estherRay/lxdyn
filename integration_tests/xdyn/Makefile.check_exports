# h5dump and python used to come from a purpose-built `xdyn-check` debian image. Both are
# ordinary host tools, so the image is gone; H5DUMP/PYTHON are overridable if yours are not
# on PATH.
#
# The original recipes accumulated exit codes into .commands.result and then asked
# `grep -q 0` whether any of them had passed — which reports success as long as *one* of
# the checks succeeded, and left the file behind to poison the next run. Two of the
# branches were also unparseable (`exit 1 \` with no `;` before `else`), so the failure
# path could never have run. These check each command's status directly instead.

# Every dataset that must be present when the YAML asks for the extra outputs.
EXPORTED_DATASETS = /inputs/meshes/TestShip/faces \
                    /scripts/MatLab/demoMatLab.m \
                    /scripts/Python/demoPython.py \
                    /inputs/yaml/input \
                    /outputs/waves/t /outputs/waves/x /outputs/waves/y /outputs/waves/z \
                    /outputs/spectra/00/a /outputs/spectra/00/gamma /outputs/spectra/00/k \
                    /outputs/spectra/00/omega /outputs/spectra/00/phase

test_output_size: demos
	@echo "Checking if we get the correct time vector in HDF5, CSV"
	@cd $(WORK) && $(XDYN) --dt 0.1 --tend 1 test_ship_in_waves.yml -o res.hdf5
	@cd $(WORK) && $(PYTHON) check_output_size.py hdf5 res.hdf5
	@cd $(WORK) && $(XDYN) --dt 0.1 --tend 1 test_ship_in_waves.yml -o res.hdf5 -s euler
	@cd $(WORK) && $(PYTHON) check_output_size.py hdf5 res.hdf5
	@cd $(WORK) && $(XDYN) --dt 0.1 --tend 1 test_ship_in_waves.yml -o res.csv
	@cd $(WORK) && $(PYTHON) check_output_size.py csv res.csv
	@cd $(WORK) && $(XDYN) --dt 0.1 --tend 1 test_ship_in_waves.yml -o res.csv -s euler
	@cd $(WORK) && $(PYTHON) check_output_size.py csv res.csv
	@cd $(WORK) && rm -f res.hdf5 res.csv
	@echo Success

extra_hdf5_output_when_required: demos
	@echo "Checking if we can output scripts, meshes, command line, waves, spectra & YAML"
	@cd $(WORK) && rm -f test.h5 && $(XDYN) --dt 1 --tend 1 test_ship_in_waves.yml
	@cd $(WORK) && for d in $(EXPORTED_DATASETS); do \
		if ! $(H5DUMP) -d "$$d" -c 1 test.h5 > /dev/null 2>&1; then \
			echo "Missing from the HDF5 file, but the YAML asked for it: $$d" && exit 1; \
		fi; \
	done
	@echo "Found everything in the HDF5 file: test passed!"

no_extra_hdf5_output_when_not_required: demos
	@echo "Checking scripts, meshes, command line, waves, spectra & YAML are *not* outputted by default"
	@cd $(WORK) && sed 's/data:.*/data: []/g' test_ship_in_waves.yml > test_ship_in_waves.yml.new
	@cd $(WORK) && rm -f test.h5 && $(XDYN) --dt 1 --tend 1 test_ship_in_waves.yml.new
	@cd $(WORK) && for d in $(EXPORTED_DATASETS); do \
		if $(H5DUMP) -d "$$d" -c 1 test.h5 > /dev/null 2>&1; then \
			echo "Present in the HDF5 file, but nothing asked for it: $$d" && exit 1; \
		fi; \
	done
	@echo "Nothing outputted, as expected: test passed!"
